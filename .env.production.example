# Copy to .env ON THE SERVER. These values are what production needs;
# running the development .env in production is what breaks CORS and login.

# Must be "production": it is what switches auth cookies to
# SameSite=None + Secure, which is required because the browser talks to
# backend.bashirahmedsons.com from bashirahmedsons.com (a cross-site request).
NODE_ENV=production
PORT=3008

DB_HOST=147.93.122.109
DB_PORT=3306
DB_USER=bash_uSSRF4baSHiRRsON
DB_PASSWORD=__set_me__
DB_NAME=bash_MeRnDbBashiRSoNS

JWT_CUSTOMER_SECRET=__set_me__
JWT_ADMIN_SECRET=__set_me__
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

COOKIE_DOMAIN=backend.bashirahmedsons.com

GMAIL_USER=bashirahmedsons0@gmail.com
GMAIL_PASS=__set_me__
EMAIL_FROM="Bashir Ahmed Sons <bashirahmedsons0@gmail.com>"
ADMIN_ALERT_EMAIL=bashirahmedsons0@gmail.com

# The origin the browser loads the site from. This is the CORS allowlist:
# if it is wrong or missing, every API call from the live site is blocked.
CUSTOMER_APP_URL=https://bashirahmedsons.com
ADMIN_APP_PATH=/admin

# Add the Vercel preview URL here if you still deploy there.
CORS_ORIGINS=

UPLOAD_MAX_FILE_SIZE_MB=5
